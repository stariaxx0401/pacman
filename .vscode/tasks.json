{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Pacman",
      "type": "shell",
      "command": "C:/msys64/mingw64/bin/g++.exe",
      "args": [
        "-g",
        "src/main.cpp",
        "-o",
        "pacman.exe",
        "-I", "C:/SFML2/SFML-2.6.2/include",
        "-L", "C:/SFML2/SFML-2.6.2/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system",
        "-lsfml-audio"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}